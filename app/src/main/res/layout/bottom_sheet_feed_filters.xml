<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="@dimen/spacing_lg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/feed_sheet_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_headline" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:fontFamily="sans-serif-medium"
        android:text="@string/feed_sheet_vibe_label"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <Spinner
        android:id="@+id/feed_spinner_vibe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/feed_switch_match_palette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/feed_sheet_palette_switch" />

    <TextView
        android:id="@+id/feed_TV_palette_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/feed_palette_no_data_hint"
        android:fontFamily="sans-serif"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/feed_btn_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/feed_sheet_apply"
        app:cornerRadius="@dimen/corner_button"
        app:backgroundTint="@color/primary" />
</LinearLayout>
